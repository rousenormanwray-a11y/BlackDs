{
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"pnpm --filter web dev\" \"pnpm --filter api start:dev\"",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@types/node": "^20.0.0"
  }
}